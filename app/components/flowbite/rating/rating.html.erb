<%= tag.div(class: container_classes.join(" "), **options) do %>
  <div class="flex items-center space-x-1">
    <% stars.each do |filled| %>
      <%= render(Flowbite::Rating::Star.new(filled: filled, size: size)) %>
    <% end %>
  </div>

  <span class="sr-only"><%= screen_reader_text %></span>

  <% if text.present? %>
    <p class="ms-2 text-sm font-medium text-body"><%= text %></p>
  <% end %>
<% end %>

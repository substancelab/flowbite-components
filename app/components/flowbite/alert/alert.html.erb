<%= tag.div(
  class: container_classes.join(" "),
  role: "alert",
  **options,
) do %>
  <% if additional_content? %>
    <% if icon? || title? %>
      <div class="flex items-center">
        <% if icon? %>
          <%= render Flowbite::Alert::Icon.new(class: icon_classes) %>
          <span class="sr-only"><%= style_label %></span>
        <% end %>

        <% if title? %>
          <h3 class="font-medium"><%= title %></h3>
        <% end %>
      </div>
    <% end %>
    <% if content.present? %>
      <div class="mt-2 mb-4"><%= content %></div>
    <% end %>
    <%= additional_content %>
  <% elsif icon? %>
    <%= render Flowbite::Alert::Icon.new(class: icon_classes) %>
    <span class="sr-only"><%= style_label %></span>
    <div>
      <% if title? %>
        <span class="font-medium me-1"><%= title %></span>
      <% end %><%= content %>
    </div>
  <% else %>
    <% if title? %>
      <span class="font-medium"><%= title %></span>
    <% end %><%= content %>
  <% end %>
<% end %>
